# ===== Autenticação do admin =====
# Senha única que libera o modo de edição (admin). Troque por algo forte.
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório longo, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=gere-um-valor-aleatorio-longo

# ===== Banco de dados (Upstash Redis / Vercel KV) =====
# Ao criar um Upstash Redis no marketplace da Vercel, estas variáveis são injetadas
# automaticamente (às vezes com o prefixo KV_ em vez de UPSTASH_). O app aceita os dois.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternativa (Vercel KV):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
